ns1:Attributes a owl:Class .

ns1:NNPS a ns1:poscoarse .

ns1:Sentence_0_10 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_10_8 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_11 ;
    ns1:previousSentence ns1:Sentence_0_9 ;
    ns1:senttext "The applications we have implemented in ANDES allow an investigator to identify and compare the variations within a sample or among multiple samples ." .

ns1:Sentence_0_11 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_11_23 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_12 ;
    ns1:previousSentence ns1:Sentence_0_10 ;
    ns1:senttext "To identify the nature of sequencing artifacts and how they may impact the analyses of a 16S metagenomic sample , ANDES was applied to compute empirically - determined quality values on a set of 454 Titanium sequencing runs ." .

ns1:Sentence_0_12 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_12_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_13 ;
    ns1:previousSentence ns1:Sentence_0_11 ;
    ns1:senttext "Project name : ANDES Project home page :   Download web site :   Operating system : Tested and in production on Linux ." .

ns1:Sentence_0_13 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_13_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_14 ;
    ns1:previousSentence ns1:Sentence_0_12 ;
    ns1:senttext "Programming language : Perl and R License : GNU GPL V 3" .

ns1:Sentence_0_14 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_14_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_15 ;
    ns1:previousSentence ns1:Sentence_0_13 ;
    ns1:senttext "Any restrictions to use by non - academics : none" .

ns1:Sentence_0_15 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_15_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_16 ;
    ns1:previousSentence ns1:Sentence_0_14 ;
    ns1:senttext "In this paper , we present a lossless compression tool , MAFCO , specifically designed to compress MAF ( Multiple Alignment Format ) files ." .

ns1:Sentence_0_16 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_16_11 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_17 ;
    ns1:previousSentence ns1:Sentence_0_15 ;
    ns1:senttext "Both source - code and binaries for several operating systems are freely available for non - commercial use at :   ." .

ns1:Sentence_0_18 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_18_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_19 ;
    ns1:previousSentence ns1:Sentence_0_17 ;
    ns1:senttext "Availability" .

ns1:Sentence_0_19 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_19_7 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_20 ;
    ns1:previousSentence ns1:Sentence_0_18 ;
    ns1:senttext "The MAFCO compression tool can be found at :   ;   ." .

ns1:Sentence_0_2 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_2_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_3 ;
    ns1:previousSentence ns1:Sentence_0_1 ;
    ns1:senttext "The resource is available free of charge for academic users from URL :   ." .

ns1:Sentence_0_20 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_20_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_21 ;
    ns1:previousSentence ns1:Sentence_0_19 ;
    ns1:senttext "Here , we introduce PyPhi , a Python software package that implements this framework for causal analysis and unfolds the full cause - effect structure of discrete dynamical systems of binary elements ." .

ns1:Sentence_0_21 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_21_17 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_22 ;
    ns1:previousSentence ns1:Sentence_0_20 ;
    ns1:senttext "PyPhi is open - source and licensed under the GPLv 3 ; the source code is hosted on GitHub at   ." .

ns1:Sentence_0_22 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_22_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_23 ;
    ns1:previousSentence ns1:Sentence_0_21 ;
    ns1:senttext "Here we describe PyPhi , a Python software package that implements IIT ' s framework for causal analysis and unfolds the full CES of discrete Markovian dynamical systems of binary elements ." .

ns1:Sentence_0_23 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_23_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_24 ;
    ns1:previousSentence ns1:Sentence_0_22 ;
    ns1:senttext "Here we describe coXpress , an R package that allows researchers to identify groups of genes that are differentially co - expressed ." .

ns1:Sentence_0_24 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_24_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_25 ;
    ns1:previousSentence ns1:Sentence_0_23 ;
    ns1:senttext "We have developed coXpress as a means of identifying groups of genes that are differentially co - expressed ." .

ns1:Sentence_0_25 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_25_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_26 ;
    ns1:previousSentence ns1:Sentence_0_24 ;
    ns1:senttext "Here we describe coXpress , a simple and easy to use package that allows users to explore differential co - expression in an intuitive way ." .

ns1:Sentence_0_26 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_26_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_27 ;
    ns1:previousSentence ns1:Sentence_0_25 ;
    ns1:senttext "CoXpress uses hierarchical cluster analysis to explore the relationship between genes , cutting the tree to form groups of genes that are co - expressed ." .

ns1:Sentence_0_27 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_27_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_28 ;
    ns1:previousSentence ns1:Sentence_0_26 ;
    ns1:senttext "CoXpress is released as a package for R ." .

ns1:Sentence_0_28 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_28_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_29 ;
    ns1:previousSentence ns1:Sentence_0_27 ;
    ns1:senttext "CoXpress is written in the native R language and has been fully tested on both windows and linux ." .

ns1:Sentence_0_29 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_29_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_30 ;
    ns1:previousSentence ns1:Sentence_0_28 ;
    ns1:senttext "* Project Name : coXpress *" .

ns1:Sentence_0_3 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_3_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_4 ;
    ns1:previousSentence ns1:Sentence_0_2 ;
    ns1:senttext "In this work , we described the DelPhi package and associated resources ." .

ns1:Sentence_0_30 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_30_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_31 ;
    ns1:previousSentence ns1:Sentence_0_29 ;
    ns1:senttext "Project Home Page :   *" .

ns1:Sentence_0_31 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_31_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_32 ;
    ns1:previousSentence ns1:Sentence_0_30 ;
    ns1:senttext "Operating Systems : Windows , Linux *" .

ns1:Sentence_0_32 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_32_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_33 ;
    ns1:previousSentence ns1:Sentence_0_31 ;
    ns1:senttext "Programming Language : R *" .

ns1:Sentence_0_33 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_33_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_34 ;
    ns1:previousSentence ns1:Sentence_0_32 ;
    ns1:senttext "Other Requirements : R , gplots , gtools , gdata ( for heatmaps ) , hu 6800 , hgu 95av 2 , plotrix ( for examples ) *" .

ns1:Sentence_0_34 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_34_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_35 ;
    ns1:previousSentence ns1:Sentence_0_33 ;
    ns1:senttext "License : GNU GPL" .

ns1:Sentence_0_35 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_35_10 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_36 ;
    ns1:previousSentence ns1:Sentence_0_34 ;
    ns1:senttext "In order to solve this problem , here we developed a Portable System for the Analysis of Metabolic Models ( PSAMM ) , a new open - source software package that supports the integration of heterogeneous metadata in model annotations and provides a user - friendly interface for the analysis of metabolic models ." .

ns1:Sentence_0_36 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_36_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_37 ;
    ns1:previousSentence ns1:Sentence_0_35 ;
    ns1:senttext "PSAMM is independent of paid software environments like MATLAB , and all its dependencies are freely available for academic users ." .

ns1:Sentence_0_37 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_37_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_38 ;
    ns1:previousSentence ns1:Sentence_0_36 ;
    ns1:senttext "Here , we present a Portable System for the Analysis of Metabolic Models ( PSAMM ) , an open source software package that was implemented to support the iterative curation of GEMs by connecting model annotations with mathematical simulations ." .

ns1:Sentence_0_38 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_38_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_39 ;
    ns1:previousSentence ns1:Sentence_0_37 ;
    ns1:senttext "PSAMM was developed as an integrated software package that supports calling simulation functions using simple one - line commands ." .

ns1:Sentence_0_39 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_39_29 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_40 ;
    ns1:previousSentence ns1:Sentence_0_38 ;
    ns1:senttext "Besides the availability of diverse functions and implementations of model import    export , model checking , and constraint - based analysis , a unique feature of PSAMM is the availability of easily accessible help information that assists the users in selecting program functions and parameter values ." .

ns1:Sentence_0_4 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_4_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_5 ;
    ns1:previousSentence ns1:Sentence_0_3 ;
    ns1:senttext "Project name : DelPhi Project home page : e.g.   Operating system ( s ) : Linux , Mac , Windows Programming language : Fortran and C" .

ns1:Sentence_0_40 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_40_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_41 ;
    ns1:previousSentence ns1:Sentence_0_39 ;
    ns1:senttext "Here we introduce CloVR - ITS , an automated pipeline for comparative analysis of internal transcribed spacer ( ITS ) pyrosequences amplified from metagenomic DNA isolates and representing fungal species ." .

ns1:Sentence_0_41 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_41_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_42 ;
    ns1:previousSentence ns1:Sentence_0_40 ;
    ns1:senttext "CloVR - ITS is made available as a pre - installed , automated , and portable software pipeline for cloud - friendly execution as part of the CloVR virtual machine package (   ) ." .

ns1:Sentence_0_42 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_42_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_43 ;
    ns1:previousSentence ns1:Sentence_0_41 ;
    ns1:senttext "Here we present CloVR - ITS , a standard operating procedure ( SOP ) for ITS amplicon sequence analysis for fungal diversity studies ." .

ns1:Sentence_0_43 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_43_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_44 ;
    ns1:previousSentence ns1:Sentence_0_42 ;
    ns1:senttext "CloVR - ITS has been designed to effectively process sequence data representing any contiguous segment of the ITS region ( i.e. ITS 1 or ITS 2 ) and can perform comparative analysis of hundreds of samples ." .

ns1:Sentence_0_44 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_44_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_45 ;
    ns1:previousSentence ns1:Sentence_0_43 ;
    ns1:senttext "We present Redirector , a new Flux Balance Analysis - based framework for identifying engineering targets to optimize metabolite production in complex pathways ." .

ns1:Sentence_0_45 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_45_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_46 ;
    ns1:previousSentence ns1:Sentence_0_44 ;
    ns1:senttext "We compare the final set of flux values resulting from this Redirector optimization to fluxes resulting from the optimization for biomass ." .

ns1:Sentence_0_46 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_46_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_47 ;
    ns1:previousSentence ns1:Sentence_0_45 ;
    ns1:senttext "The Redirector framework provides a new capability in modeling metabolic alterations , using the FBA objective ." .

ns1:Sentence_0_47 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_47_12 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_48 ;
    ns1:previousSentence ns1:Sentence_0_46 ;
    ns1:senttext "To demonstrate its capacity to optimize challenging pathways , we have applied Redirector to the production of myristoyl - CoA , examining the highest growth parameter design as well as the dependency analysis of multiple designs ." .

ns1:Sentence_0_48 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_48_17 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_49 ;
    ns1:previousSentence ns1:Sentence_0_47 ;
    ns1:senttext "The Redirector Package including operational software code and metabolic network model files used for this publication are available at   ." .

ns1:Sentence_0_49 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_49_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_50 ;
    ns1:previousSentence ns1:Sentence_0_48 ;
    ns1:senttext "Here , we present an easily accessible software toolkit , called ENCORE , which can be used to compare conformational ensembles generated either from simulations alone or synergistically with experiments ." .

ns1:Sentence_0_5 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_5_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_6 ;
    ns1:previousSentence ns1:Sentence_0_4 ;
    ns1:senttext "Other requirements : no License : free of charge license is required" .

ns1:Sentence_0_50 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_50_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_51 ;
    ns1:previousSentence ns1:Sentence_0_49 ;
    ns1:senttext "ENCORE is freely available and extendable , integrates with the established MDAnalysis software package , reads ensemble data in many common formats , and can work with large trajectory files ." .

ns1:Sentence_0_51 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_51_10 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_52 ;
    ns1:previousSentence ns1:Sentence_0_50 ;
    ns1:senttext "The library , called ENCORE (   ) , interfaces with the MDAnalysis molecular analysis toolkit [ 14 ] and can be used both as a Python library and from the command line ." .

ns1:Sentence_0_52 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_52_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_53 ;
    ns1:previousSentence ns1:Sentence_0_51 ;
    ns1:senttext "ENCORE is freely available (   ) , together with its documentation and several examples on how to use it , and is distributed under the GNU general public license , version 3 ." .

ns1:Sentence_0_53 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_53_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_54 ;
    ns1:previousSentence ns1:Sentence_0_52 ;
    ns1:senttext "Here we present PhyloBot , a web - based software tool that makes ancestral sequence reconstruction easy ." .

ns1:Sentence_0_54 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_54_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_55 ;
    ns1:previousSentence ns1:Sentence_0_53 ;
    ns1:senttext "PhyloBot runs in a web browser , and is available at the following URL :   ." .

ns1:Sentence_0_55 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_55_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_56 ;
    ns1:previousSentence ns1:Sentence_0_54 ;
    ns1:senttext "PhyloBot is a web portal that automates the reconstruction of ancestral amino acid sequences ." .

ns1:Sentence_0_56 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_56_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_57 ;
    ns1:previousSentence ns1:Sentence_0_55 ;
    ns1:senttext "Users are welcome to use an instance of PhyloBot available at   , or launch their own instance of PhyloBot using its open - source code ." .

ns1:Sentence_0_57 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_57_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_58 ;
    ns1:previousSentence ns1:Sentence_0_56 ;
    ns1:senttext "PhyloBot is available to use at   , and its source code is available at" .

ns1:Sentence_0_59 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_59_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_60 ;
    ns1:previousSentence ns1:Sentence_0_58 ;
    ns1:senttext "We have recently developed Mindboggle as a fully automated , feature - matching approach to assign anatomical labels to cortical structures and activity in human brain MRI data ." .

ns1:Sentence_0_6 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_6_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_7 ;
    ns1:previousSentence ns1:Sentence_0_5 ;
    ns1:senttext "Any restrictions to use by non - academics :" .

ns1:Sentence_0_60 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_60_12 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_61 ;
    ns1:previousSentence ns1:Sentence_0_59 ;
    ns1:senttext "Each brain image voxel of each of 20 human subjects is assigned a label by each of the remaining 19 atlases using Mindboggle ." .

ns1:Sentence_0_61 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_61_7 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_62 ;
    ns1:previousSentence ns1:Sentence_0_60 ;
    ns1:senttext "In this paper , we have chosen to extend the use of an individual atlas to multiple atlases in a recently introduced , fully automated , feature - based nonlinear labeling method called Mindboggle ( freely downloadable , open source Matlab code ) [" .

ns1:Sentence_0_62 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_62_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_63 ;
    ns1:previousSentence ns1:Sentence_0_61 ;
    ns1:senttext "63,85" .

ns1:Sentence_0_63 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_63_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_64 ;
    ns1:previousSentence ns1:Sentence_0_62 ;
    ns1:senttext "]" .

ns1:Sentence_0_64 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_64_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_65 ;
    ns1:previousSentence ns1:Sentence_0_63 ;
    ns1:senttext "." .

ns1:Sentence_0_65 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_65_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_66 ;
    ns1:previousSentence ns1:Sentence_0_64 ;
    ns1:senttext "Mindboggle is a freely downloadable , open source software package written in Matlab ( version 6 , release 13 , with the Image Processing Toolbox , The Mathworks Inc . , USA ) and has been tested on different models of desktop and laptop computers running different distributions of Linux , as well as MacOSX and Windows ." .

ns1:Sentence_0_66 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_66_10 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_67 ;
    ns1:previousSentence ns1:Sentence_0_65 ;
    ns1:senttext "A HMMER web server (   ) has been designed and implemented such that most protein database searches return within a few seconds ." .

ns1:Sentence_0_7 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_7_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_8 ;
    ns1:previousSentence ns1:Sentence_0_6 ;
    ns1:senttext "Commercial users should contact Accelrys Inc ." .

ns1:Sentence_0_8 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_8_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_9 ;
    ns1:previousSentence ns1:Sentence_0_7 ;
    ns1:senttext "" .

ns1:Sentence_0_9 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_9_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_10 ;
    ns1:previousSentence ns1:Sentence_0_8 ;
    ns1:senttext "We have developed ANDES , a software library and a suite of applications , written in Perl and R , for the statistical ANalyses of DEep Sequencing ." .

