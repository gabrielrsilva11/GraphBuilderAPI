    ns1:nextSentence ns1:Sentence_0_185 ;
    ns1:previousSentence ns1:Sentence_0_183 ;
    ns1:senttext "BAGHDAD 1996 - 08 - 22" .

ns1:Sentence_0_185 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_185_2 ;
