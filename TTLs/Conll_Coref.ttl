    ns1:previousSentence ns1:Sentence_0_78 ;
    ns1:senttext "Port conditions from Lloyds Shipping Intelligence Service -- LATTAKIA , Aug 10 - waiting time at Lattakia and Tartous presently 24 hours ." .

ns1:Sentence_0_8 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_8_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_9 ;
    ns1:previousSentence ns1:Sentence_0_7 ;
    ns1:senttext "Fischler proposed EU - wide measures after reports from Britain and France that under laboratory conditions sheep could contract Bovine Spongiform Encephalopathy ( BSE ) -- mad cow disease ." .

ns1:Sentence_0_80 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_80_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_81 ;
    ns1:previousSentence ns1:Sentence_0_79 ;
    ns1:senttext "Israel plays down fears of war with Syria ." .

ns1:Sentence_0_81 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_81_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_82 ;
    ns1:previousSentence ns1:Sentence_0_80 ;
    ns1:senttext "Colleen Siegel" .

ns1:Sentence_0_82 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_82_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_83 ;
    ns1:previousSentence ns1:Sentence_0_81 ;
    ns1:senttext "JERUSALEM 1996 - 08 - 22" .

ns1:Sentence_0_83 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_83_8 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_84 ;
    ns1:previousSentence ns1:Sentence_0_82 ;
    ns1:senttext "Israel s outgoing peace negotiator with Syria said on Thursday current tensions between the two countries appeared to be a storm in a teacup ." .

ns1:Sentence_0_84 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_84_17 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_85 ;
    ns1:previousSentence ns1:Sentence_0_83 ;
    ns1:senttext "Itamar Rabinovich , who as Israel s ambassador to Washington conducted unfruitful negotiations with Syria , told Israel Radio it looked like Damascus wanted to talk rather than fight ." .

ns1:Sentence_0_85 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_85_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_86 ;
    ns1:previousSentence ns1:Sentence_0_84 ;
    ns1:senttext "It appears to me the Syrian priority is still to negotiate ." .

ns1:Sentence_0_88 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_88_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_89 ;
    ns1:previousSentence ns1:Sentence_0_87 ;
    ns1:senttext "Rabinovich is winding up his term as ambassador ." .

ns1:Sentence_0_89 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_89_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_90 ;
    ns1:previousSentence ns1:Sentence_0_88 ;
    ns1:senttext "He will be replaced by Eliahu Ben - Elissar , a former Israeli envoy to Egypt and right - wing Likud party politician ." .

ns1:Sentence_0_9 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_9_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_10 ;
    ns1:previousSentence ns1:Sentence_0_8 ;
    ns1:senttext "But Fischler agreed to review his proposal after the EU s standing veterinary committee , mational animal health officials , questioned if such action was justified as there was only a slight risk to human health ." .

ns1:Sentence_0_90 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_90_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_91 ;
    ns1:previousSentence ns1:Sentence_0_89 ;
    ns1:senttext "Israel on Wednesday sent Syria a message , via Washington , saying it was committed to peace and wanted to open negotiations without preconditions ." .

ns1:Sentence_0_91 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_91_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_92 ;
    ns1:previousSentence ns1:Sentence_0_90 ;
    ns1:senttext "But it slammed Damascus for creating what it called a dangerous atmosphere ." .

ns1:Sentence_0_92 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_92_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_93 ;
    ns1:previousSentence ns1:Sentence_0_91 ;
    ns1:senttext "Syria accused Israel on Wednesday of launching a hysterical campaign against it after Israeli television reported that Damascus had recently test fired a missile ." .

ns1:Sentence_0_93 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_93_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_94 ;
    ns1:previousSentence ns1:Sentence_0_92 ;
    ns1:senttext "It said its arms purchases were for defensive purposes ." .

ns1:Sentence_0_94 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_94_36 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_95 ;
    ns1:previousSentence ns1:Sentence_0_93 ;
    ns1:senttext "The message that we sent to ( Syrian President Hafez al- ) Assad is that Israel is ready at any time without preconditions to enter peace negotiations ,  Israeli Foreign Minister David Levy told Israel Radio in an interview ." .

ns1:Sentence_0_95 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_95_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_96 ;
    ns1:previousSentence ns1:Sentence_0_94 ;
    ns1:senttext "Tension has mounted since Israeli Prime Minister Benjamin Netanyahu took office in June vowing to retain the Golan Heights Israel captured from Syria in the 1967 Middle East war ." .

ns1:Sentence_0_96 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_96_8 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_97 ;
    ns1:previousSentence ns1:Sentence_0_95 ;
    ns1:senttext "Israeli - Syrian peace talks have been deadlocked over the Golan since 1991 despite the previous government s willingness to make Golan concessions ." .

ns1:Sentence_0_97 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_97_9 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_98 ;
    ns1:previousSentence ns1:Sentence_0_96 ;
    ns1:senttext "Peace talks between the two sides were last held in February ." .

ns1:Sentence_0_98 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_98_8 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_99 ;
    ns1:previousSentence ns1:Sentence_0_97 ;
    ns1:senttext "The voices coming out of Damascus are bad , not good ." .

ns1:Sentence_0_99 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_99_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_100 ;
    ns1:previousSentence ns1:Sentence_0_98 ;
    ns1:senttext "The media ... are full of expressions and declarations that must be worrying ..." .

