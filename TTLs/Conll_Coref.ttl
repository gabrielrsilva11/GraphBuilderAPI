ns1:Attributes a owl:Class .

ns1:Sentence_0_10 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_10_9 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_11 ;
    ns1:previousSentence ns1:Sentence_0_9 ;
    ns1:senttext "Spanish Farm Minister Loyola de Palacio had earlier accused Fischler at an EU farm ministers  meeting of causing unjustified alarm through  dangerous generalisation .  ." .

ns1:Sentence_0_100 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_100_19 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_101 ;
    ns1:previousSentence ns1:Sentence_0_99 ;
    ns1:senttext "this artificial atmosphere is very dangerous because those who spread it could become its prisoners ,  Levy said ." .

ns1:Sentence_0_101 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_101_33 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_102 ;
    ns1:previousSentence ns1:Sentence_0_100 ;
    ns1:senttext "We expect from Syria , if its face is to peace , that it will answer Israel s message to enter peace negotiations because that is our goal ,  he said ." .

ns1:Sentence_0_102 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_102_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_103 ;
    ns1:previousSentence ns1:Sentence_0_101 ;
    ns1:senttext "We do not want a war , God forbid ." .

ns1:Sentence_0_103 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_103_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_104 ;
    ns1:previousSentence ns1:Sentence_0_102 ;
    ns1:senttext "No one benefits from wars ." .

ns1:Sentence_0_104 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_104_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_105 ;
    ns1:previousSentence ns1:Sentence_0_103 ;
    ns1:senttext "Israel s Channel Two television said Damascus had sent a  calming signal  to Israel ." .

ns1:Sentence_0_105 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_105_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_106 ;
    ns1:previousSentence ns1:Sentence_0_104 ;
    ns1:senttext "It gave no source for the report ." .

ns1:Sentence_0_106 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_106_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_107 ;
    ns1:previousSentence ns1:Sentence_0_105 ;
    ns1:senttext "Netanyahu and Levy s spokesmen said they could not confirm it ." .

ns1:Sentence_0_107 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_107_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_108 ;
    ns1:previousSentence ns1:Sentence_0_106 ;
    ns1:senttext "The television also said that Netanyahu had sent messages to reassure Syria via Cairo , the United States and Moscow ." .

ns1:Sentence_0_108 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_108_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_109 ;
    ns1:previousSentence ns1:Sentence_0_107 ;
    ns1:senttext "Polish diplomat denies nurses stranded in Libya ." .

ns1:Sentence_0_109 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_109_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_110 ;
    ns1:previousSentence ns1:Sentence_0_108 ;
    ns1:senttext "TUNIS 1996 - 08 - 22" .

ns1:Sentence_0_11 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_11_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_12 ;
    ns1:previousSentence ns1:Sentence_0_10 ;
    ns1:senttext "Only France and Britain backed Fischler s proposal ." .

ns1:Sentence_0_110 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_110_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_111 ;
    ns1:previousSentence ns1:Sentence_0_109 ;
    ns1:senttext "A Polish diplomat on Thursday denied a Polish tabloid report this week that Libya was refusing exit visas to 100 Polish nurses trying to return home after working in the North African country ." .

ns1:Sentence_0_111 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_111_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_112 ;
    ns1:previousSentence ns1:Sentence_0_110 ;
    ns1:senttext "This is not true ." .

ns1:Sentence_0_112 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_112_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_113 ;
    ns1:previousSentence ns1:Sentence_0_111 ;
    ns1:senttext "Up to today , we have no knowledge of any nurse stranded or kept in Libya without her will , and we have not received any complaint" .

ns1:Sentence_0_113 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_113_15 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_114 ;
    ns1:previousSentence ns1:Sentence_0_112 ;
    ns1:senttext ",  the Polish embassy s charge daffaires in Tripoli , Tadeusz Awdankiewicz , told Reuters by telephone ." .

ns1:Sentence_0_114 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_114_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_115 ;
    ns1:previousSentence ns1:Sentence_0_113 ;
    ns1:senttext "Poland s labour ministry said this week it would send a team to Libya to investigate , but Awdankiewicz said the probe was prompted by some nurses complaining about their work conditions such as non - payment of their salaries ." .

ns1:Sentence_0_115 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_115_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_116 ;
    ns1:previousSentence ns1:Sentence_0_114 ;
    ns1:senttext "He said that there are an estimated 800 Polish nurses working in Libya ." .

ns1:Sentence_0_116 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_116_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_117 ;
    ns1:previousSentence ns1:Sentence_0_115 ;
    ns1:senttext "Two Iranian opposition leaders meet in Baghdad ." .

ns1:Sentence_0_117 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_117_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_118 ;
    ns1:previousSentence ns1:Sentence_0_116 ;
    ns1:senttext "Hassan Hafidh BAGHDAD 1996 - 08 - 22" .

ns1:Sentence_0_118 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_118_8 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_119 ;
    ns1:previousSentence ns1:Sentence_0_117 ;
    ns1:senttext "An Iranian exile group based in Iraq vowed on Thursday to extend support to Iran s Kurdish rebels after they were attacked by Iranian troops deep inside Iraq last month ." .

ns1:Sentence_0_119 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_119_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_120 ;
    ns1:previousSentence ns1:Sentence_0_118 ;
    ns1:senttext "A Mujahideen Khalq statement said its leader Massoud Rajavi met in Baghdad the Secretary - General of the Kurdistan Democratic Party of Iran ( KDPI ) Hassan Rastegar on Wednesday and voiced his support to Iran s rebel Kurds ." .

ns1:Sentence_0_12 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_12_9 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_13 ;
    ns1:previousSentence ns1:Sentence_0_11 ;
    ns1:senttext "The EU s scientific veterinary and multidisciplinary committees are due to re - examine the issue early next month and make recommendations to the senior veterinary officials ." .

ns1:Sentence_0_120 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_120_29 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_121 ;
    ns1:previousSentence ns1:Sentence_0_119 ;
    ns1:senttext "Rajavi emphasised that the Iranian Resistance would continue to stand side by side with their Kurdish compatriots and the resistance movement in Iranian Kurdistan ,  it said ." .

ns1:Sentence_0_121 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_121_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_122 ;
    ns1:previousSentence ns1:Sentence_0_120 ;
    ns1:senttext "A spokesman for the group said the meeting  signals a new level of cooperation between Mujahideen Khalq and the Iranian Kurdish oppositions  ." .

ns1:Sentence_0_122 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_122_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_123 ;
    ns1:previousSentence ns1:Sentence_0_121 ;
    ns1:senttext "Iran heavily bombarded targets in northern Iraq in July in pursuit of KDPI guerrillas based in Iraqi Kurdish areas outside the control of the government in Baghdad ." .

ns1:Sentence_0_123 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_123_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_124 ;
    ns1:previousSentence ns1:Sentence_0_122 ;
    ns1:senttext "Iraqi Kurdish areas bordering Iran are under the control of guerrillas of the Iraqi Kurdish Patriotic Union of Kurdistan ( PUK ) group ." .

ns1:Sentence_0_124 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_124_19 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_125 ;
    ns1:previousSentence ns1:Sentence_0_123 ;
    ns1:senttext "PUK and Iraq s Kurdistan Democratic Party ( KDP ) the two main Iraqi Kurdish factions , have had northern Iraq under their control since Iraqi forces were ousted from Kuwait in the 1991 Gulf War ." .

ns1:Sentence_0_125 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_125_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_126 ;
    ns1:previousSentence ns1:Sentence_0_124 ;
    ns1:senttext "Clashes between the two parties broke out at the weekend in the most serious fighting since a U.S.-sponsored ceasefire last year ." .

ns1:Sentence_0_126 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_126_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_127 ;
    ns1:previousSentence ns1:Sentence_0_125 ;
    ns1:senttext "Mujahideen Khalq said Iranian troops had also been shelling KDP positions in Qasri region in Suleimaniya province near the Iranian border over the last two days ." .

ns1:Sentence_0_127 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_127_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_128 ;
    ns1:previousSentence ns1:Sentence_0_126 ;
    ns1:senttext "It said about 100 Iraqi Kurds were killed or wounded in the attack ." .

ns1:Sentence_0_128 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_128_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_129 ;
    ns1:previousSentence ns1:Sentence_0_127 ;
    ns1:senttext "Both Iran and Turkey mount air and land strikes at targets in northern Iraq in pursuit of their own Kurdish rebels ." .

ns1:Sentence_0_129 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_129_8 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_130 ;
    ns1:previousSentence ns1:Sentence_0_128 ;
    ns1:senttext "A U.S.-led air force in southern Turkey protects Iraqi Kurds from possible attacks by Baghdad troops ." .

ns1:Sentence_0_13 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_13_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_14 ;
    ns1:previousSentence ns1:Sentence_0_12 ;
    ns1:senttext "Sheep have long been known to contract scrapie , a brain - wasting disease similar to BSE which is believed to have been transferred to cattle through feed containing animal waste ." .

ns1:Sentence_0_130 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_130_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_131 ;
    ns1:previousSentence ns1:Sentence_0_129 ;
    ns1:senttext "Saudi riyal rates steady in quiet summer trade ." .

ns1:Sentence_0_131 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_131_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_132 ;
    ns1:previousSentence ns1:Sentence_0_130 ;
    ns1:senttext "MANAMA 1996 - 08 - 22" .

ns1:Sentence_0_132 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_132_27 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_133 ;
    ns1:previousSentence ns1:Sentence_0_131 ;
    ns1:senttext "The spot Saudi riyal against the dollar and riyal interbank deposit rates were mainly steady this week in quiet summer trade , dealers in the kingdom said ." .

ns1:Sentence_0_133 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_133_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_134 ;
    ns1:previousSentence ns1:Sentence_0_132 ;
    ns1:senttext "There were no changes in Saudi riyal rates ." .

ns1:Sentence_0_134 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_134_14 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_135 ;
    ns1:previousSentence ns1:Sentence_0_133 ;
    ns1:senttext "The market was very quiet because of summer holidays ,  one dealer said ." .

ns1:Sentence_0_135 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_135_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_136 ;
    ns1:previousSentence ns1:Sentence_0_134 ;
    ns1:senttext "The spot riyal was put at 3.7504 / 06 to the dollar ." .

ns1:Sentence_0_138 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_138_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_139 ;
    ns1:previousSentence ns1:Sentence_0_137 ;
    ns1:senttext "One - year funds were at six , 5 - 7/8 percent ." .

ns1:Sentence_0_139 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_139_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_140 ;
    ns1:previousSentence ns1:Sentence_0_138 ;
    ns1:senttext "Israel approves Arafat s flight to West Bank ." .

ns1:Sentence_0_14 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_14_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_15 ;
    ns1:previousSentence ns1:Sentence_0_13 ;
    ns1:senttext "British farmers denied on Thursday there was any danger to human health from their sheep , but expressed concern that German government advice to consumers to avoid British lamb might influence consumers across Europe ." .

ns1:Sentence_0_140 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_140_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_141 ;
    ns1:previousSentence ns1:Sentence_0_139 ;
    ns1:senttext "JERUSALEM 1996 - 08 - 22" .

ns1:Sentence_0_141 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_141_31 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_142 ;
    ns1:previousSentence ns1:Sentence_0_140 ;
    ns1:senttext "Israel gave Palestinian President Yasser Arafat permission on Thursday to fly over its territory to the West Bank , ending a brief Israeli - PLO crisis , an Arafat adviser said ." .

ns1:Sentence_0_142 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_142_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_143 ;
    ns1:previousSentence ns1:Sentence_0_141 ;
    ns1:senttext "The problem is over ." .

ns1:Sentence_0_143 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_143_32 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_144 ;
    ns1:previousSentence ns1:Sentence_0_142 ;
    ns1:senttext "The president s aircraft has received permission to pass through Israeli airspace but the president is not expected to travel to the West Bank before Monday ,  Nabil Abu Rdainah told Reuters ." .

ns1:Sentence_0_144 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_144_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_145 ;
    ns1:previousSentence ns1:Sentence_0_143 ;
    ns1:senttext "Arafat had been scheduled to meet former Israeli prime minister Shimon Peres in the West Bank town of Ramallah on Thursday but the venue was changed to Gaza after Israel denied flight clearance to the Palestinian leader s helicopters ." .

ns1:Sentence_0_145 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_145_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_146 ;
    ns1:previousSentence ns1:Sentence_0_144 ;
    ns1:senttext "Palestinian officials accused right - wing Prime Minister Benjamin Netanyahu of trying to stop the Ramallah meeting by keeping Arafat grounded ." .

ns1:Sentence_0_146 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_146_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_147 ;
    ns1:previousSentence ns1:Sentence_0_145 ;
    ns1:senttext "Arafat subsequently cancelled a meeting between Israeli and PLO officials , on civilian affairs , at the Allenby Bridge crossing between Jordan and the West Bank ." .

ns1:Sentence_0_147 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_147_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_148 ;
    ns1:previousSentence ns1:Sentence_0_146 ;
    ns1:senttext "Abu Rdainah said Arafat had decided against flying to the West Bank on Thursday , after Israel lifted the ban , because he had a busy schedule in Gaza and would not be free until Monday ." .

ns1:Sentence_0_148 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_148_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_149 ;
    ns1:previousSentence ns1:Sentence_0_147 ;
    ns1:senttext "Arafat to meet Peres in Gaza after flight ban ." .

ns1:Sentence_0_149 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_149_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_150 ;
    ns1:previousSentence ns1:Sentence_0_148 ;
    ns1:senttext "JERUSALEM 1996 - 08 - 22" .

ns1:Sentence_0_15 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_15_35 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_16 ;
    ns1:previousSentence ns1:Sentence_0_14 ;
    ns1:senttext "What we have to be extremely careful of is how other countries are going to take Germany s lead ,  Welsh National Farmers  Union ( NFU ) chairman John Lloyd Jones said on BBC radio ." .

ns1:Sentence_0_150 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_150_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_151 ;
    ns1:previousSentence ns1:Sentence_0_149 ;
    ns1:senttext "Yasser Arafat will meet Shimon Peres in Gaza on Thursday after Palestinians said the right - wing Israeli government had barred the Palestinian leader from flying to the West Bank for talks with the former prime minister ." .

ns1:Sentence_0_151 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_151_27 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_152 ;
    ns1:previousSentence ns1:Sentence_0_150 ;
    ns1:senttext "The meeting between Peres and Arafat will take place at Erez checkpoint in Gaza and not in Ramallah as planned ,  Peres  office said ." .

ns1:Sentence_0_152 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_152_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_153 ;
    ns1:previousSentence ns1:Sentence_0_151 ;
    ns1:senttext "Palestinian officials said the Israeli government had barred Arafat from overflying Israel in a Palestinian helicopter to the West Bank in an attempt to bar the meeting with Peres ." .

ns1:Sentence_0_153 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_153_7 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_154 ;
    ns1:previousSentence ns1:Sentence_0_152 ;
    ns1:senttext "Israeli Prime Minister Benjamin Netanyahu has accused opposition leader Peres , who he defeated in May elections , of trying to undermine his Likud government s authority to conduct peace talks ." .

ns1:Sentence_0_154 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_154_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_155 ;
    ns1:previousSentence ns1:Sentence_0_153 ;
    ns1:senttext "Afghan UAE embassy says Taleban guards going home ." .

ns1:Sentence_0_155 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_155_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_156 ;
    ns1:previousSentence ns1:Sentence_0_154 ;
    ns1:senttext "Hilary Gush DUBAI 1996 - 08 - 22" .

ns1:Sentence_0_156 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_156_36 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_157 ;
    ns1:previousSentence ns1:Sentence_0_155 ;
    ns1:senttext "Three Afghan guards brought to the United Arab Emirates last week by Russian hostages who escaped from the Taleban militia will return to Afghanistan in a few days , the Afghan embassy in Abu Dhabi said on Thursday ." .

ns1:Sentence_0_157 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_157_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_158 ;
    ns1:previousSentence ns1:Sentence_0_156 ;
    ns1:senttext "Our ambassador is in touch with the UAE foreign ministry ." .

ns1:Sentence_0_158 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_158_18 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_159 ;
    ns1:previousSentence ns1:Sentence_0_157 ;
    ns1:senttext "Their return to Afghanistan will take place in two or three days ,  an embassy official said ." .

ns1:Sentence_0_159 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_159_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_160 ;
    ns1:previousSentence ns1:Sentence_0_158 ;
    ns1:senttext "The embassy is issuing them travel documents for their return to their homeland ." .

ns1:Sentence_0_16 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_16_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_17 ;
    ns1:previousSentence ns1:Sentence_0_15 ;
    ns1:senttext "Bonn has led efforts to protect public health after consumer confidence collapsed in March after a British report suggested humans could contract an illness similar to mad cow disease by eating contaminated beef ." .

ns1:Sentence_0_160 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_160_11 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_161 ;
    ns1:previousSentence ns1:Sentence_0_159 ;
    ns1:senttext "There is no objection to their travel ,  he added ." .

ns1:Sentence_0_161 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_161_7 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_162 ;
    ns1:previousSentence ns1:Sentence_0_160 ;
    ns1:senttext "The three Islamic Taleban guards were overpowered by seven Russian aircrew who escaped to UAE state Sharjah last Friday on board their own aircraft after a year in the captivity of Taleban militia in Kandahar in southern Afghanistan ." .

ns1:Sentence_0_162 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_162_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_163 ;
    ns1:previousSentence ns1:Sentence_0_161 ;
    ns1:senttext "The UAE said on Monday it would hand over the three to the International Red Crescent , possibly last Tuesday ." .

ns1:Sentence_0_163 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_163_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_164 ;
    ns1:previousSentence ns1:Sentence_0_162 ;
    ns1:senttext "It has since been silent on the issue ." .

ns1:Sentence_0_164 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_164_21 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_165 ;
    ns1:previousSentence ns1:Sentence_0_163 ;
    ns1:senttext "When asked whether the three guards would travel back to Kandahar or the Afghan capital Kabul , the embassy official said :  That has not been decided , but possibly Kandahar ." .

ns1:Sentence_0_165 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_165_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_166 ;
    ns1:previousSentence ns1:Sentence_0_164 ;
    ns1:senttext "Kandahar is the headquarters of the opposition Taleban militia ." .

ns1:Sentence_0_166 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_166_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_167 ;
    ns1:previousSentence ns1:Sentence_0_165 ;
    ns1:senttext "Kabul is controlled by President Burhanuddin Rabbani s government , which Taleban is fighting to overthrow ." .

ns1:Sentence_0_167 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_167_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_168 ;
    ns1:previousSentence ns1:Sentence_0_166 ;
    ns1:senttext "The embassy official said the three men , believed to be in their 20s , were currently in Abu Dhabi ." .

ns1:Sentence_0_168 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_168_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_169 ;
    ns1:previousSentence ns1:Sentence_0_167 ;
    ns1:senttext "He did not elaborate ." .

ns1:Sentence_0_169 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_169_17 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_170 ;
    ns1:previousSentence ns1:Sentence_0_168 ;
    ns1:senttext "The Russians , working for the Aerostan firm in the Russian republic of Tatarstan , were taken hostage after a Taleban MiG-19 fighter forced their cargo plane to land in August 1995 ." .

ns1:Sentence_0_17 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_17_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_18 ;
    ns1:previousSentence ns1:Sentence_0_16 ;
    ns1:senttext "Germany imported 47,600 sheep from Britain last year , nearly half of total imports ." .

ns1:Sentence_0_170 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_170_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_171 ;
    ns1:previousSentence ns1:Sentence_0_169 ;
    ns1:senttext "Taleban said its shipment of ammunition from Albania was evidence of Russian military support for Rabbani s government ." .

ns1:Sentence_0_171 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_171_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_172 ;
    ns1:previousSentence ns1:Sentence_0_170 ;
    ns1:senttext "Moscow said the crew s nationality was coincidental ." .

ns1:Sentence_0_172 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_172_8 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_173 ;
    ns1:previousSentence ns1:Sentence_0_171 ;
    ns1:senttext "Numerous diplomatic attempts to free the seven failed ." .

ns1:Sentence_0_173 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_173_32 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_174 ;
    ns1:previousSentence ns1:Sentence_0_172 ;
    ns1:senttext "The Russians , who said they overpowered the guards -- two armed with Kalashnikov automatic rifles -- while doing regular maintenance work on their Ilyushin 76 cargo plane last Friday , left the UAE capital Abu Dhabi for home on Sunday ." .

ns1:Sentence_0_174 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_174_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_175 ;
    ns1:previousSentence ns1:Sentence_0_173 ;
    ns1:senttext "Iraq s Saddam meets Russia s Zhirinovsky ." .

ns1:Sentence_0_175 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_175_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_176 ;
    ns1:previousSentence ns1:Sentence_0_174 ;
    ns1:senttext "BAGHDAD 1996 - 08 - 22" .

ns1:Sentence_0_176 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_176_30 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_177 ;
    ns1:previousSentence ns1:Sentence_0_175 ;
    ns1:senttext "Iraqi President Saddam Hussein has told visiting Russian ultra - nationalist Vladimir Zhirinovsky that Baghdad wanted to maintain  friendship and cooperation  with Moscow , official Iraqi newspapers said on Thursday ." .

ns1:Sentence_0_177 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_177_23 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_178 ;
    ns1:previousSentence ns1:Sentence_0_176 ;
    ns1:senttext "President Saddam Hussein stressed during the meeting Iraq s keenness to maintain friendship and cooperation with Russia ,  the papers said ." .

ns1:Sentence_0_178 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_178_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_179 ;
    ns1:previousSentence ns1:Sentence_0_177 ;
    ns1:senttext "They said Zhirinovsky told Saddam before he left Baghdad on Wednesday that his Liberal Democratic party and the Russian Duma ( parliament )  are calling for an immediate lifting of the embargo  imposed on Iraq after its 1990 invasion of Kuwait ." .

ns1:Sentence_0_179 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_179_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_180 ;
    ns1:previousSentence ns1:Sentence_0_178 ;
    ns1:senttext "Zhirinovsky said on Tuesday he would press the Russian government to help end U.N. trade sanctions on Iraq and blamed Moscow for delaying establishment of good ties with Baghdad ." .

ns1:Sentence_0_18 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_18_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_19 ;
    ns1:previousSentence ns1:Sentence_0_17 ;
    ns1:senttext "It brought in 4,275 tonnes of British mutton , some 10 percent of overall imports ." .

ns1:Sentence_0_180 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_180_35 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_181 ;
    ns1:previousSentence ns1:Sentence_0_179 ;
    ns1:senttext "Our stand is firm , namely we are calling on ( the Russian ) government to end the economic embargo on Iraq and resume trade ties between Russia and Iraq ,  he told reporters ." .

ns1:Sentence_0_181 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_181_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_182 ;
    ns1:previousSentence ns1:Sentence_0_180 ;
    ns1:senttext "Zhirinovsky visited Iraq twice in 1995 ." .

ns1:Sentence_0_182 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_182_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_183 ;
    ns1:previousSentence ns1:Sentence_0_181 ;
    ns1:senttext "Last October he was invited to attend the referendum held on Iraq s presidency , which extended Saddam s term for seven more years ." .

ns1:Sentence_0_183 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_183_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_184 ;
    ns1:previousSentence ns1:Sentence_0_182 ;
    ns1:senttext "PRESS DIGEST - Iraq - Aug 22 ." .

