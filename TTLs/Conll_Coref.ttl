    ns1:nextSentence ns1:Sentence_0_20 ;
    ns1:previousSentence ns1:Sentence_0_18 ;
    ns1:senttext "Rare Hendrix song draft sells for almost $ 17,000 ." .

ns1:Sentence_0_2 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_2_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_3 ;
    ns1:previousSentence ns1:Sentence_0_1 ;
    ns1:senttext "Peter Blackburn BRUSSELS 1996 - 08 - 22" .

ns1:Sentence_0_20 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_20_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_21 ;
    ns1:previousSentence ns1:Sentence_0_19 ;
    ns1:senttext "LONDON 1996 - 08 -" .

ns1:Sentence_0_21 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_21_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_22 ;
    ns1:previousSentence ns1:Sentence_0_20 ;
    ns1:senttext "22" .

ns1:Sentence_0_22 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_22_16 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_23 ;
    ns1:previousSentence ns1:Sentence_0_21 ;
    ns1:senttext "A rare early handwritten draft of a song by U.S. guitar legend Jimi Hendrix was sold for almost $ 17,000 on Thursday at an auction of some of the late musician s favourite possessions ." .

ns1:Sentence_0_23 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_23_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_24 ;
    ns1:previousSentence ns1:Sentence_0_22 ;
    ns1:senttext "A Florida restaurant paid 10,925 pounds ( $ 16,935 ) for the draft of  Ai nt no telling  , which Hendrix penned on a piece of London hotel stationery in late 1966 ." .

ns1:Sentence_0_24 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_24_16 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_25 ;
    ns1:previousSentence ns1:Sentence_0_23 ;
    ns1:senttext "At the end of a January 1967 concert in the English city of Nottingham he threw the sheet of paper into the audience , where it was retrieved by a fan ." .

ns1:Sentence_0_25 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_25_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_26 ;
    ns1:previousSentence ns1:Sentence_0_24 ;
    ns1:senttext "Buyers also snapped up 16 other items that were put up for auction by Hendrix s former girlfriend Kathy Etchingham , who lived with him from 1966 to 1969 ." .

ns1:Sentence_0_26 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_26_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_27 ;
    ns1:previousSentence ns1:Sentence_0_25 ;
    ns1:senttext "They included a black lacquer and mother of pearl inlaid box used by Hendrix to store his drugs , which an anonymous Australian purchaser bought for 5,060 pounds ( $ 7,845 ) ." .

ns1:Sentence_0_27 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_27_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_28 ;
    ns1:previousSentence ns1:Sentence_0_26 ;
    ns1:senttext "The guitarist died of a drugs overdose in 1970 aged 27 ." .

ns1:Sentence_0_28 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_28_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_29 ;
    ns1:previousSentence ns1:Sentence_0_27 ;
    ns1:senttext "China says Taiwan spoils atmosphere for talks ." .

ns1:Sentence_0_29 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_29_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_30 ;
    ns1:previousSentence ns1:Sentence_0_28 ;
    ns1:senttext "BEIJING 1996 - 08 - 22" .

ns1:Sentence_0_3 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_3_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_4 ;
    ns1:previousSentence ns1:Sentence_0_2 ;
    ns1:senttext "The European Commission said on Thursday it disagreed with German advice to consumers to shun British lamb until scientists determine whether mad cow disease can be transmitted to sheep ." .

ns1:Sentence_0_30 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_30_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_31 ;
    ns1:previousSentence ns1:Sentence_0_29 ;
    ns1:senttext "China on Thursday accused Taipei of spoiling the atmosphere for a resumption of talks across the Taiwan Strait with a visit to Ukraine by Taiwanese Vice President Lien Chan this week that infuriated Beijing ." .

ns1:Sentence_0_31 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_31_26 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_32 ;
    ns1:previousSentence ns1:Sentence_0_30 ;
    ns1:senttext "Speaking only hours after Chinese state media said the time was right to engage in political talks with Taiwan , Foreign Ministry spokesman Shen Guofang told Reuters :  The necessary atmosphere for the opening of the talks has been disrupted by the Taiwan authorities ." .

ns1:Sentence_0_32 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_32_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_33 ;
    ns1:previousSentence ns1:Sentence_0_31 ;
    ns1:senttext "State media quoted China s top negotiator with Taipei , Tang Shubei , as telling a visiting group from Taiwan on Wednesday that it was time for the rivals to hold political talks ." .

ns1:Sentence_0_33 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_33_35 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_34 ;
    ns1:previousSentence ns1:Sentence_0_32 ;
    ns1:senttext "Now is the time for the two sides to engage in political talks ... that is to end the state of hostility ,  Thursday s overseas edition of the People s Daily quoted Tang as saying ." .

ns1:Sentence_0_34 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_34_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_35 ;
    ns1:previousSentence ns1:Sentence_0_33 ;
    ns1:senttext "The foreign ministry s Shen told Reuters Television in an interview he had read reports of Tang s comments but gave no details of why the negotiator had considered the time right for talks with Taiwan , which Beijing considers a renegade province ." .

ns1:Sentence_0_35 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_35_17 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_36 ;
    ns1:previousSentence ns1:Sentence_0_34 ;
    ns1:senttext "China , which has long opposed all Taipei efforts to gain greater international recognition , was infuriated by a visit to Ukraine this week by Taiwanese Vice President Lien ." .

ns1:Sentence_0_36 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_36_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_37 ;
    ns1:previousSentence ns1:Sentence_0_35 ;
    ns1:senttext "China says time right for Taiwan talks ." .

ns1:Sentence_0_37 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_37_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_38 ;
    ns1:previousSentence ns1:Sentence_0_36 ;
    ns1:senttext "BEIJING 1996 - 08 - 22" .

ns1:Sentence_0_38 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_38_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_39 ;
    ns1:previousSentence ns1:Sentence_0_37 ;
    ns1:senttext "China has said it was time for political talks with Taiwan and that the rival island should take practical steps towards that goal ." .

ns1:Sentence_0_39 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_39_20 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_40 ;
    ns1:previousSentence ns1:Sentence_0_38 ;
    ns1:senttext "Consultations should be held to set the time and format of the talks , the official Xinhua news agency quoted Tang Shubei , executive vice chairman of the Association for Relations Across the Taiwan Straits , as saying late on Wednesday ." .

ns1:Sentence_0_4 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_4_13 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_5 ;
    ns1:previousSentence ns1:Sentence_0_3 ;
    ns1:senttext "Germany s representative to the European Union s veterinary committee Werner Zwingmann said on Wednesday consumers should buy sheepmeat from countries other than Britain until the scientific advice was clearer ." .

ns1:Sentence_0_40 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_40_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_41 ;
    ns1:previousSentence ns1:Sentence_0_39 ;
    ns1:senttext "German July car registrations up 14.2 pct yr / yr ." .

ns1:Sentence_0_41 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_41_1 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_42 ;
    ns1:previousSentence ns1:Sentence_0_40 ;
    ns1:senttext "FRANKFURT 1996 - 08 - 22" .

ns1:Sentence_0_42 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_42_29 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_43 ;
    ns1:previousSentence ns1:Sentence_0_41 ;
    ns1:senttext "German first - time registrations of motor vehicles jumped 14.2 percent in July this year from the year - earlier period , the Federal office for motor vehicles said on Thursday ." .

ns1:Sentence_0_43 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_43_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_44 ;
    ns1:previousSentence ns1:Sentence_0_42 ;
    ns1:senttext "The office said 356,725 new cars were registered in July 1996 -- 304,850 passenger cars and 15,613 trucks ." .

ns1:Sentence_0_44 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_44_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_45 ;
    ns1:previousSentence ns1:Sentence_0_43 ;
    ns1:senttext "The figures represent a 13.6 percent increase for passenger cars and a 2.2 percent decline for trucks from July 1995 ." .

ns1:Sentence_0_45 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_45_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_46 ;
    ns1:previousSentence ns1:Sentence_0_44 ;
    ns1:senttext "Motor - bike registration rose 32.7 percent in the period ." .

ns1:Sentence_0_46 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_46_29 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_47 ;
    ns1:previousSentence ns1:Sentence_0_45 ;
    ns1:senttext "The growth was partly due to an increased number of Germans buying German cars abroad , while manufacturers said that domestic demand was weak , the federal office said ." .

ns1:Sentence_0_47 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_47_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_48 ;
    ns1:previousSentence ns1:Sentence_0_46 ;
    ns1:senttext "Almost all German car manufacturers posted gains in registration numbers in the period ." .

ns1:Sentence_0_5 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_5_29 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_6 ;
    ns1:previousSentence ns1:Sentence_0_4 ;
    ns1:senttext "We do nt support any such recommendation because we do nt see any grounds for it ,  the Commission s chief spokesman Nikolaus van der Pas told a news briefing ." .

ns1:Sentence_0_50 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_50_7 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_51 ;
    ns1:previousSentence ns1:Sentence_0_49 ;
    ns1:senttext "Opel AG together with General Motors came in second place with 49,269 registrations , 16.4 percent of the overall figure ." .

ns1:Sentence_0_51 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_51_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_52 ;
    ns1:previousSentence ns1:Sentence_0_50 ;
    ns1:senttext "Third was Ford with 35,563 registrations , or 11.7 percent ." .

ns1:Sentence_0_52 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_52_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_53 ;
    ns1:previousSentence ns1:Sentence_0_51 ;
    ns1:senttext "Only Seat and Porsche had fewer registrations in July 1996 compared to last year s July ." .

ns1:Sentence_0_53 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_53_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_54 ;
    ns1:previousSentence ns1:Sentence_0_52 ;
    ns1:senttext "Seat posted 3,420 registrations compared with 5522 registrations in July a year earlier ." .

ns1:Sentence_0_54 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_54_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_55 ;
    ns1:previousSentence ns1:Sentence_0_53 ;
    ns1:senttext "Porsche s registrations fell to 554 from 643 ." .

ns1:Sentence_0_55 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_55_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_56 ;
    ns1:previousSentence ns1:Sentence_0_54 ;
    ns1:senttext "GREEK SOCIALISTS GIVE GREEN LIGHT TO PM FOR ELECTIONS ." .

