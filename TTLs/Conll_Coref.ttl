    ns1:nextSentence ns1:Sentence_0_186 ;
    ns1:previousSentence ns1:Sentence_0_184 ;
    ns1:senttext "These are some of the leading stories in the official Iraqi press on Thursday ." .

ns1:Sentence_0_19 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_19_5 ;
