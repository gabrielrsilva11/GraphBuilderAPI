ns1:Attributes a owl:Class .

ns1:Sentence_0_10 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_10_9 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_11 ;
    ns1:previousSentence ns1:Sentence_0_9 ;
    ns1:senttext "On July 9 , 1781 , Samuel Johnston became the first man to be elected as president of Congress after the ratification of the Articles ." .

ns1:Sentence_0_100 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_100_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_101 ;
    ns1:previousSentence ns1:Sentence_0_99 ;
    ns1:senttext "The new approach resulted in increasingly strained relations with the US ." .

ns1:Sentence_0_101 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_101_9 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_102 ;
    ns1:previousSentence ns1:Sentence_0_100 ;
    ns1:senttext "In Mehmed II first reign , Mehmed II defeated the crusade led by Janos Hunyadi after the Hungarian incursions into Mehmed II country broke the conditions of the truce Peace of Szeged ." .

ns1:Sentence_0_11 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_11_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_12 ;
    ns1:previousSentence ns1:Sentence_0_10 ;
    ns1:senttext "Oppenheimer feared that the high cliffs surrounding the site would make his people feel claustrophobic , while the engineers were concerned with the possibility of flooding ." .

ns1:Sentence_0_12 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_12_13 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_13 ;
    ns1:previousSentence ns1:Sentence_0_11 ;
    ns1:senttext "Already in the 10th century , the Christians of northern Spain had begun what would eventually become the Reconquista : the reconquest of Spain for Christendom ." .

ns1:Sentence_0_13 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_13_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_14 ;
    ns1:previousSentence ns1:Sentence_0_12 ;
    ns1:senttext "Philip was influenced both by the troubles and unrest that Philip V of France father had encountered during 1314 , and the difficulties that Philip V of France older brother -- Louis X , known as ` ` the Quarreler APOSAPOS had faced during the intervening few years ." .

ns1:Sentence_0_14 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_14_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_15 ;
    ns1:previousSentence ns1:Sentence_0_13 ;
    ns1:senttext "Luis de Camoes was charged with managing the properties of missing and deceased soldiers in the Orient ." .

ns1:Sentence_0_15 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_15_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_16 ;
    ns1:previousSentence ns1:Sentence_0_14 ;
    ns1:senttext "Martinez posted an exceptional 1.74 ERA , the AL APOSs lowest since 1978 , while winning Pedro Martinez third Cy Young award ." .

ns1:Sentence_0_16 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_16_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_17 ;
    ns1:previousSentence ns1:Sentence_0_15 ;
    ns1:senttext "John Diefenbaker continued a high - profile legal practice , and in 1933 , ran for mayor of Prince Albert ." .

ns1:Sentence_0_17 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_17_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_18 ;
    ns1:previousSentence ns1:Sentence_0_16 ;
    ns1:senttext "Sleipnir is the horse of Bagri Maro ." .

ns1:Sentence_0_18 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_18_9 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_19 ;
    ns1:previousSentence ns1:Sentence_0_17 ;
    ns1:senttext "These guards , called express messengers , became known as shotgun messengers , since Shotgun rode with the weapon ( loaded with buckshot ) for defense against bandits ." .

ns1:Sentence_0_19 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_19_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_20 ;
    ns1:previousSentence ns1:Sentence_0_18 ;
    ns1:senttext "Peter Sellers is a Jolly Good Fellow ." .

ns1:Sentence_0_2 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_2_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_3 ;
    ns1:previousSentence ns1:Sentence_0_1 ;
    ns1:senttext "Bracing can also be used to correct problems caused by CMT ." .

ns1:Sentence_0_20 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_20_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_21 ;
    ns1:previousSentence ns1:Sentence_0_19 ;
    ns1:senttext "Celeron is a product concept ." .

ns1:Sentence_0_21 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_21_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_22 ;
    ns1:previousSentence ns1:Sentence_0_20 ;
    ns1:senttext "In 1941 , Wigner married Eugene Wigner second wife , Mary Annette Wheeler , a professor of physics at Vassar College , who had completed her Ph.D. at Yale University in 1932 ." .

ns1:Sentence_0_22 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_22_41 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_23 ;
    ns1:previousSentence ns1:Sentence_0_21 ;
    ns1:senttext "The F - corona ( F for Fraunhofer ) is created by sunlight bouncing off dust particles , and is observable because Corona light contains the Fraunhofer absorption lines that are seen in raw sunlight ; the F - corona extends to very high elongation angles from the Sun , where Corona is called the zodiacal light ." .

ns1:Sentence_0_23 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_23_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_24 ;
    ns1:previousSentence ns1:Sentence_0_22 ;
    ns1:senttext "However , Betelgeuse has a much lower density than the Sun ." .

ns1:Sentence_0_24 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_24_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_25 ;
    ns1:previousSentence ns1:Sentence_0_23 ;
    ns1:senttext "This was because most of the farms and Corned beef produce were owned by wealthy Anglo - Irish landlords and that most of the population were from families of poor tenant farmers , and that most of the corned beef was exported ." .

ns1:Sentence_0_25 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_25_10 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_26 ;
    ns1:previousSentence ns1:Sentence_0_24 ;
    ns1:senttext "A young man named Radio Raheem ( Nunn ) lives for nothing else but to blast Public Enemy APOSs ` ` Fight the Power APOSAPOS on his boombox wherever he goes ." .

ns1:Sentence_0_26 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_26_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_27 ;
    ns1:previousSentence ns1:Sentence_0_25 ;
    ns1:senttext "Atlantis is Otto Muck APOSs ` ` Crantor ." .

ns1:Sentence_0_27 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_27_29 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_28 ;
    ns1:previousSentence ns1:Sentence_0_26 ;
    ns1:senttext "As west - bound shipping from Europe usually reached the subtropics at about the time the ` ` dead horse APOSAPOS was worked off , the latitude became associated with the ceremony ." .

ns1:Sentence_0_28 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_28_8 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_29 ;
    ns1:previousSentence ns1:Sentence_0_27 ;
    ns1:senttext "( chroniclers such as al - Bakri allege Ibn Yasin APOSs own learning was superficial ." .

ns1:Sentence_0_29 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_29_22 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_30 ;
    ns1:previousSentence ns1:Sentence_0_28 ;
    ns1:senttext "By the end of 1204 John , King of England had around 50 large galleys available ; another 54 vessels were built between 1209 and 1212 ." .

ns1:Sentence_0_3 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_3_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_4 ;
    ns1:previousSentence ns1:Sentence_0_2 ;
    ns1:senttext "Patrick Stewart also starred as Scrooge in a 1999 television film version of Charles Dickens APOSs A Christmas Carol , receiving a Screen Actors Guild Award nomination for Patrick Stewart performance ." .

ns1:Sentence_0_30 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_30_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_31 ;
    ns1:previousSentence ns1:Sentence_0_29 ;
    ns1:senttext "Scorpius is a large constellation located in the southern hemisphere near the center of the Milky Way ." .

ns1:Sentence_0_31 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_31_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_32 ;
