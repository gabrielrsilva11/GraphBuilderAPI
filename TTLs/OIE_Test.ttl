    ns1:previousSentence ns1:Sentence_0_88 ;
    ns1:senttext "Because of his widely publicised love affairs , Christiaan Barnard became jokingly known as ` ` doctor of hearts APOSAPOS , referring to the heart as an emotional symbol rather than in its usual medical context ." .

ns1:Sentence_0_9 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_9_10 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_10 ;
    ns1:previousSentence ns1:Sentence_0_8 ;
    ns1:senttext "The denomination 422 BC for this year has been used since the early medieval period , when the Anno Domini calendar era became the prevalent method in Europe for naming years ." .

ns1:Sentence_0_90 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_90_23 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_91 ;
    ns1:previousSentence ns1:Sentence_0_89 ;
    ns1:senttext "Joseph Proust APOSs law of definite composition says that pure chemicals are composed of elements in a definite formulation ; we now know that the structural arrangement of these elements is also important ." .

ns1:Sentence_0_91 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_91_9 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_92 ;
    ns1:previousSentence ns1:Sentence_0_90 ;
    ns1:senttext "Strabo , writing some 400 years later , adds that Charaxus was trading with Lesbian wine and that Sappho called Rhodopis Doricha ." .

ns1:Sentence_0_92 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_92_13 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_93 ;
    ns1:previousSentence ns1:Sentence_0_91 ;
    ns1:senttext "The appearance of a comet during games in Julius Caesar honour was taken as confirmation of Julius Caesar divinity ." .

ns1:Sentence_0_93 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_93_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_94 ;
    ns1:previousSentence ns1:Sentence_0_92 ;
    ns1:senttext "Common chimpanzee is a whole ." .

ns1:Sentence_0_94 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_94_14 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_95 ;
    ns1:previousSentence ns1:Sentence_0_93 ;
    ns1:senttext "One twist to the hypothesis by engineer Thomas Dehel ( 2006 ) , proposes that plasmoid magnetic fields ejected from the magnetosphere may move the few spores lifted from the Earth APOSs atmosphere with sufficient speed to cross interstellar space to other systems before the spores can be destroyed ." .

ns1:Sentence_0_95 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_95_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_96 ;
    ns1:previousSentence ns1:Sentence_0_94 ;
    ns1:senttext "Some creators have presumed that his family is simply a German branch of the Duck family that has nAPOSt been included in any major stories ." .

ns1:Sentence_0_96 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_96_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_97 ;
    ns1:previousSentence ns1:Sentence_0_95 ;
    ns1:senttext "Hingis did not play any tournaments after the China Open , as Martina Hingis was beset by injuries for the rest of the year ." .

ns1:Sentence_0_97 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_97_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_98 ;
    ns1:previousSentence ns1:Sentence_0_96 ;
    ns1:senttext "Analysis of the Internet shows the trends ." .

ns1:Sentence_0_98 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_98_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_99 ;
    ns1:previousSentence ns1:Sentence_0_97 ;
    ns1:senttext "Thunderstorm also occur in the cool unstable air that often follows the passage of a cold front from the sea during winter ." .

ns1:Sentence_0_99 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_99_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_100 ;
    ns1:previousSentence ns1:Sentence_0_98 ;
    ns1:senttext "Meiosis also involves a stage of chromosomal crossover , in which regions of DNA are exchanged between matched types of chromosomes , to form a new pair of mixed chromosomes ." .

