ns1:Attributes a owl:Class .

ns1:Sentence_0_10 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_10_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_11 ;
    ns1:previousSentence ns1:Sentence_0_9 ;
    ns1:senttext "A piada britanica e dito ter sido colocado para descansar quando  a paz se rompeu  no final da guerra , como os paises concordam com uma proibicao Joke Warfare na Convencao de Genebra ." .

ns1:Sentence_0_11 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_11_51 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_12 ;
    ns1:previousSentence ns1:Sentence_0_10 ;
    ns1:senttext "Foi provado por essas investigacoes que uma superficie recem-limpa de zinco , se carregada com eletricidade negativa , rapidamente perde esta carga no entanto pequeno efeito fotoeletrico pode ser quando a luz ultra-violeta cai sobre a superficie ; enquanto se a superficie e descarregada para comecar , o efeito fotoeletrico adquire uma carga positiva quando exposta a luz , a electrificacao negativa saindo para o gas pelo qual o metal e cercado ; esta electrificacao positiva pode ser muito ; esta electrificacao positiva pode ser muito ." .

ns1:Sentence_0_12 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_12_10 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_13 ;
    ns1:previousSentence ns1:Sentence_0_11 ;
    ns1:senttext "Em 1939 o industrialista da Filadelfia Samuel Simeon Fels encomendou Samuel Barber a escrever um concerto de violino para a divisao de Fels , Iso Briselli , um graduado do Curtis Institute of Music no mesmo ano que Samuel Barber , 1934 ." .

