    ns1:nextSentence ns1:Sentence_0_3 ;
    ns1:previousSentence ns1:Sentence_0_1 ;
    ns1:senttext "Pesquisas mostram que a razao pela qual a mente completa uma figura regular que nao e percebida atraves da sensacao e aumentar a regularidade dos estimulos circundantes ." .

ns1:Sentence_0_3 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_3_12 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_4 ;
    ns1:previousSentence ns1:Sentence_0_2 ;
    ns1:senttext "No primeiro , de 1938 a 1939 , Joachim von Ribbentrop tentou persuadir outros estados a alinhar-se com a Alemanha para a proxima guerra ." .

ns1:Sentence_0_4 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_4_9 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_5 ;
    ns1:previousSentence ns1:Sentence_0_3 ;
    ns1:senttext "As cameras baratas de obturador de folhas tambem beneficiaram da medicao das lentes para tras , pois a Topcon introduziu o Auto 100 com lentes intercambiaveis de montagem frontal projetadas apenas para camera de reflexo unica lente e uma das cameras de obturador de folhas Zeiss Ikon Contaflex ." .

ns1:Sentence_0_5 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_5_8 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_6 ;
    ns1:previousSentence ns1:Sentence_0_4 ;
    ns1:senttext "Em marco de 2006 , Steve Wozniak participou da PRIMEIRA Competicao Nacional em Atlanta para mostrar robos Lego ." .

ns1:Sentence_0_6 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_6_11 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_7 ;
    ns1:previousSentence ns1:Sentence_0_5 ;
    ns1:senttext "Na configuracao cliente de NAT , configurar o gateway e suficiente ." .

ns1:Sentence_0_7 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_7_7 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_8 ;
    ns1:previousSentence ns1:Sentence_0_6 ;
    ns1:senttext "O Comandante-em-Chefe da SAF e o Presidente da Republica da Eslovenia ( Borut Pahor ) , enquanto o comando operacional esta no dominio do Chefe do Estado-Maior Geral dos Militares da Eslovenia , cargo que ocupa desde fevereiro de 2012 pelo brigadeiro Dobran Bozic ." .

ns1:Sentence_0_8 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_8_8 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_9 ;
    ns1:previousSentence ns1:Sentence_0_7 ;
    ns1:senttext "Nesses casos , os Vikings eram extremamente vulneraveis a perseguicao de Alfred as Grandes Forcas Militares ." .

ns1:Sentence_0_9 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_9_18 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_10 ;
    ns1:previousSentence ns1:Sentence_0_8 ;
    ns1:senttext "Apos a abertura inicial do Muro de Berlim em 9 de novembro de 1989 , Potsdamer Platz tornou-se um dos locais mais antigos onde o Muro foi  quebrado  para criar uma nova fronteira entre Berlim Oriental e Ocidental ." .

