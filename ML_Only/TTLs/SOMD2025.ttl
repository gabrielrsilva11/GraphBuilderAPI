ns1:Sentence_0_10 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_10_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_11 ;
    ns1:previousSentence ns1:Sentence_0_9 ;
    ns1:senttext "Statistical analyses were performed with SigmaPlot 11.0 ( Systat , Inc . , San Jose , CA . )" .

ns1:Sentence_0_11 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_11_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_12 ;
    ns1:previousSentence ns1:Sentence_0_10 ;
    ns1:senttext "QTL analysis was performed using QTL Express ( http://qtlcap.ed.ac.uk ) , qxpak v 2.16 [55] and R / Qtl [56] for the standard interval mapping and epistatic analyses ." .

ns1:Sentence_0_12 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_12_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_13 ;
    ns1:previousSentence ns1:Sentence_0_11 ;
    ns1:senttext "Results were computed using SPSS ver. 15 ( SPSS Inc , Illinois , USA ) , employing the ' Complex Samples ' procedure required when using probability weights ." .

ns1:Sentence_0_13 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_13_11 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_14 ;
    ns1:previousSentence ns1:Sentence_0_12 ;
    ns1:senttext "Target genes of miR - 497 - 5p were firstly predicted using microRNA ( http://www.microrna.org/microrna/home.do ) , TargetScan ( http://www.targetscan.org ) , and miRDB ( http://mirdb.org/ ) , and then , intersection analyzed by Venny ( version 2.1.0 ; http://bioinfogp.cnb.csic.es/tools/venny/index.html ) ." .

ns1:Sentence_0_14 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_14_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_15 ;
    ns1:previousSentence ns1:Sentence_0_13 ;
    ns1:senttext "All data were analyzed parametrically with Prism 5 statistical software ( GraphPad ) ." .

ns1:Sentence_0_15 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_15_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_16 ;
    ns1:previousSentence ns1:Sentence_0_14 ;
    ns1:senttext "This analysis included samples that had specific locations or provincial localities ." .

ns1:Sentence_0_16 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_16_7 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_17 ;
    ns1:previousSentence ns1:Sentence_0_15 ;
    ns1:senttext "Cluster analysis of cytokine transcripts was performed with Gene Cluster ( version 3.0 ) and visualized with Treeview ( version 1.1.6r 4 ) ." .

ns1:Sentence_0_17 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_17_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_18 ;
    ns1:previousSentence ns1:Sentence_0_16 ;
    ns1:senttext "All statistical analyses were conducted using SAS 9.3 software package ( SAS Institute , Cary , NC , USA ) ." .

ns1:Sentence_0_18 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_18_16 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_19 ;
    ns1:previousSentence ns1:Sentence_0_17 ;
    ns1:senttext "Wham and all associated software can be found on github ( https://github.com/zeeev/wham ) , documentation is on the wiki ( http://zeeev.github.io/wham/ ) ." .

ns1:Sentence_0_19 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_19_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_20 ;
    ns1:previousSentence ns1:Sentence_0_18 ;
    ns1:senttext "All statistical analyses were performed with SAS ( V 9.1.3 ) on a Win 7 ( 64 bit ) platform ." .

ns1:Sentence_0_2 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_2_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_3 ;
    ns1:previousSentence ns1:Sentence_0_1 ;
    ns1:senttext "In Uxpanapa , we later calculated the shortest distance to the nearest anthropogenic habitat ( pasture , plantation , orchard , etc . ) , shortest distance to the nearest human settlement , and the number of human settlements within a 2.5 km , 5 km and 10 km radius , using a classified 2008 Landsat satellite image ( 1 : 20,000 scale ) of the study area , the ArcView GIS software ( version 3.1 ) , and the Patch Analyst 2.2 extension for ArcView [39] ." .

ns1:Sentence_0_20 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_20_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_21 ;
    ns1:previousSentence ns1:Sentence_0_19 ;
    ns1:senttext "A multiple linear regression was conducted to isolate independent predictors of nutritional outcomes of child using SPSS version 21 windows software ." .

ns1:Sentence_0_21 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_21_6 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_22 ;
    ns1:previousSentence ns1:Sentence_0_20 ;
    ns1:senttext "The reported group analyses were conducted using a random effects model ." .

ns1:Sentence_0_22 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_22_5 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_23 ;
    ns1:previousSentence ns1:Sentence_0_21 ;
    ns1:senttext "All statistical comparisons were performed within GraphPad Prism 5 ( GraphPad Software , Inc . , La Jolla , CA ) ." .

ns1:Sentence_0_23 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_23_10 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_24 ;
    ns1:previousSentence ns1:Sentence_0_22 ;
    ns1:senttext "Convergence of the chains to the stationary distribution was checked using TRACER 1.5 [54] ." .

ns1:Sentence_0_24 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_24_2 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_25 ;
    ns1:previousSentence ns1:Sentence_0_23 ;
    ns1:senttext "We used SPSS ( v. 18.0 ; SPSS Inc . , Chicago , IL , USA ) in data analyzing ." .

ns1:Sentence_0_25 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_25_13 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_26 ;
    ns1:previousSentence ns1:Sentence_0_24 ;
    ns1:senttext "4 , 2010 from Digital Globe , Inc . Spatial analysis was performed utilizing geo - spatial modeling environment ( GME ) software version 0.5.8 beta [41] and Fragstats software version 3.3 [42] ." .

ns1:Sentence_0_26 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_26_25 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_27 ;
    ns1:previousSentence ns1:Sentence_0_25 ;
    ns1:senttext "Fractional anisotropy ( FA ) , mean diffusivity ( MD ) , axial ( DA ) and radial diffusivity ( DA ) maps were generated using DTIFit , part of FMRIB ' s Diffusion Toolbox , that fits a diffusion tensor model at each voxel [24] ." .

ns1:Sentence_0_27 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_27_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_28 ;
    ns1:previousSentence ns1:Sentence_0_26 ;
    ns1:senttext "The groups were allowed to analyze the training and test data in any way they deemed fit , but all used a combination of the following methods : ( i ) Visual inspection with dynamic varying of thresholds using a software such as Mricron or FSLView . ( ii ) Voxel - wise correlation of brain maps from the training and the test set , to find the blocks which are most similar to each other . ( iii ) Voxel - wise correlations of brain maps with maps from NeuroSynth [33] , to find the keywords from the NeuroSynth database whose posterior probability maps are most similar to the participant ' s activity patterns ." .

ns1:Sentence_0_3 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_3_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_4 ;
    ns1:previousSentence ns1:Sentence_0_2 ;
    ns1:senttext "Sequence data were imported as AB 1 files into Mutation Surveyor v 3.10 ( SoftGenetics , State College , PA ) ." .

ns1:Sentence_0_4 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_4_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_5 ;
    ns1:previousSentence ns1:Sentence_0_3 ;
    ns1:senttext "We further tested the equality of Harrell ' s C - index concordance areas of the pair - wise comparable discriminatory ability of the best - fit anthropometric measure with each of the other anthropometric measures ( six pairs ) within race - gender groups , by examining the Harrell ' s C - index and its p value [17] with Bonferroni correction for multiple testing [18] Statistical analyses were conducted using Stata MP , Version 14.0 ( StataCorp , College Station , Texas , U.S . ) ." .

ns1:Sentence_0_5 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_5_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_6 ;
    ns1:previousSentence ns1:Sentence_0_4 ;
    ns1:senttext "Calculations were carried out using Stata v 13.1 [13] and the R - library glmnet [14]" .

ns1:Sentence_0_6 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_6_3 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_7 ;
    ns1:previousSentence ns1:Sentence_0_5 ;
    ns1:senttext "Analyses were performed using SPSS 18.0 ( SPSS Inc . , Chicago , IL , United States ) ." .

ns1:Sentence_0_7 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_7_41 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_8 ;
    ns1:previousSentence ns1:Sentence_0_6 ;
    ns1:senttext "All statistical analyses that include independent samples t - tests , Cohen ' s effect size value , Pearson correlations , one - way analysis of variance ( ANOVA ) and 3 * 2 mixed - design , ANOVA were performed on the Software Package for Statistical Analysis ( SPSS for Windows version 19.0 ) , [24] ." .

ns1:Sentence_0_8 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_8_18 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_9 ;
    ns1:previousSentence ns1:Sentence_0_7 ;
    ns1:senttext "Data processing and statistical analysis : Imaging data analysis , registration , visualisation and statistical analyses were performed with the BrainVoyager QX software package ( Brain Innovation B.V . , Maastricht ; The Netherlands ) ." .

ns1:Sentence_0_9 a ns1:Sentence ;
    ns1:depGraph ns1:word_0_9_4 ;
    ns1:fromText ns1:Text_0 ;
    ns1:nextSentence ns1:Sentence_0_10 ;
    ns1:previousSentence ns1:Sentence_0_8 ;
    ns1:senttext "Regression models were estimated using IBM SPSS Version 22 ." .

